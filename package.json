{
  "name": "era-pos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": "22.16.0",
    "npm": "11.5.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @era/contracts && npm run build -w @era/api && npm run build -w @era/web && npm run build -w @era/counter",
    "dev:web": "npm run dev -w @era/web",
    "start:counter": "npm run start -w @era/counter",
    "smoke:api": "node --env-file-if-exists=.env tests/smoke/api.mjs",
    "smoke:counter": "node tests/smoke/counter.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "@eslint/js": "9.39.1",
    "globals": "16.5.0",
    "typescript-eslint": "8.48.0"
  }
}
