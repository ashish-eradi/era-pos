{
  "name": "@era/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker/main.js",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate.js",
    "seed": "node --env-file-if-exists=../../.env dist/seed.js",
    "create-operator": "node --env-file-if-exists=../../.env dist/create-operator.js"
  },
  "dependencies": {
    "@era/contracts": "0.0.0",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-express": "11.1.9",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5"
  }
}
